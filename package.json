{
   "name": "tms-admin-backend",
   "version": "1.0.0",
   "description": "Apis para panel de administración del TMS",
   "main": "index.js",
   "type": "module",
   "scripts": {
      "start": "node index.js",
      "dev": "node --watch index.js",
      "lint": "eslint . --ext .js",
      "format": "prettier --write .",
      "test": "echo \"Error: no test specified\" && exit 1",
      "prepare": "husky"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Crisolser/tms-admin-backend.git"
   },
   "author": "",
   "license": "ISC",
   "bugs": {
      "url": "https://github.com/Crisolser/tms-admin-backend/issues"
   },
   "homepage": "https://github.com/Crisolser/tms-admin-backend#readme",
   "imports": {
      "#config/*": "./src/config/*.js",
      "#models": "./src/models/index.js",
      "#middlewares": "./src/middlewares/index.js",
      "#helpers": "./src/helpers/index.js",
      "#app": "./src/app.js",
      "#repository/*": "./src/repository/*.js",
      "#constants": "./src/constants/index.js",
      "#enums": "./src/enums/index.js",
      "#seeders": "./src/seeders/index.js",
      "#data/*": "./src/data/*.json",
      "#catalogs-data": "./src/seeders/catalogs/index.js",
      "#dummy-data": "./src/seeders/dummy/index.js",
      "#authmodule/*": "./src/modules/auth/*.js",
      "#adminsmodule/*": "./src/modules/admins/*.js",
      "#clientsmodule/*": "./src/modules/clients/*.js",
      "#couriersmodule/*": "./src/modules/couriers/*.js",
      "#rolesmodule/*": "./src/modules/roles/*.js"
   },
   "dependencies": {
      "@aws-sdk/client-s3": "^3.990.0",
      "@aws-sdk/s3-request-presigner": "^3.990.0",
      "@scalar/express-api-reference": "^0.8.30",
      "bcrypt": "^6.0.0",
      "cors": "^2.8.5",
      "dotenv": "^17.2.3",
      "express": "^5.2.1",
      "jsonwebtoken": "^9.0.3",
      "morgan": "^1.10.1",
      "pg": "^8.16.3",
      "sequelize": "^6.37.7",
      "zod": "^4.2.1",
      "zod-openapi": "^5.4.5"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "eslint": "^10.0.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.5",
      "globals": "^17.3.0",
      "husky": "^9.1.7",
      "lint-staged": "^16.2.7",
      "prettier": "3.8.1"
   }
}
